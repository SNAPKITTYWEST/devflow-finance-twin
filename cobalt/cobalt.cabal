cabal-version:   3.0
name:            cobalt
version:         0.1.0
synopsis:        Cobalt — dense functor compiler to x86-64 binary
description:
  Cobalt is a Haskell compiler that transforms Prolog-style logic rules
  through a recursive functor graph (Library), fixed-point crystal
  expansion, vault transformation, trilock IR, and x86-64 binary
  emission.
license:         MIT
author:          SNAPKITTYWEST
maintainer:      jessicalw34@gmail.com
category:        Compilers/Interpreters
build-type:      Simple

library
  exposed-modules:
    Cobalt.Dense
    Cobalt.Reassembler
    Cobalt.Trilock
    CobaltReassembler
    MagicCobalt
    X86BatchAssembler
  hs-source-dirs:   .
  build-depends:
    base       >= 4.14 && < 5,
    bytestring >= 0.10,
    containers >= 0.6,
    mtl        >= 2.2
  default-language: Haskell2010
  ghc-options:      -Wall -O2

executable cobalt
  main-is:          Main.hs
  hs-source-dirs:   src
  build-depends:
    base       >= 4.14 && < 5,
    bytestring >= 0.10,
    containers >= 0.6,
    cobalt
  default-language: Haskell2010
  ghc-options:      -Wall -O2
