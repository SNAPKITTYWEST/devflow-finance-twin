-- GlobalMemory.occ
-- GPU global memory with alignment and bounds checking

#USE "RetroGPUTypes.occ"

-- Global memory manager
PROC GlobalMemoryManager(CHAN OF GMEM_MSG in?, CHAN OF GMEM_RESULT out!)
  GLOBAL_MEMORY global_mem:
  GMEM_MSG msg:
  GMEM_RESULT result:
  INT addr:

  SEQ
    global_mem[allocated_bytes] := 0

    WHILE TRUE
      SEQ
        in ? msg

        CASE msg[msg_type]
          INT size, width, value:

          -- ALLOCATE
          msg[msg_type] = GMEM_ALLOCATE
            SEQ
              size := msg[alloc_size]

              IF (global_mem[allocated_bytes] + size) < GLOBAL_SIZE
                SEQ
                  result[status] := GMEM_ALLOC_SUCCESS
                  result[address] := global_mem[allocated_bytes]
                  global_mem[allocated_bytes] := global_mem[allocated_bytes] + size
                  out ! result
              ELSE
                SEQ
                  result[status] := GMEM_ALLOC_FAILURE
                  out ! result

          -- LOAD
          msg[msg_type] = GMEM_LOAD
            SEQ
              addr := msg[address]
              width := msg[width]

              -- Validate address and width
              IF (addr >= 0) AND ((addr + width) <= GLOBAL_SIZE) AND
                 (addr REM width = 0) -- Alignment check
                SEQ
                  result[status] := GMEM_LOAD_SUCCESS
                  result[value] := 0 -- Would read from global_mem[data]
                  out ! result
              ELSE
                SEQ
                  result[status] := GMEM_LOAD_FAILURE
                  out ! result

          -- STORE
          msg[msg_type] = GMEM_STORE
            SEQ
              addr := msg[address]
              value := msg[value]
              width := msg[width]

              IF (addr >= 0) AND ((addr + width) <= GLOBAL_SIZE) AND
                 (addr REM width = 0)
                SEQ
                  result[status] := GMEM_STORE_SUCCESS
                  out ! result
              ELSE
                SEQ
                  result[status] := GMEM_STORE_FAILURE
                  out ! result

:

VAL INT GMEM_ALLOCATE IS 0:
VAL INT GMEM_DEALLOCATE IS 1:
VAL INT GMEM_LOAD IS 2:
VAL INT GMEM_STORE IS 3:
VAL INT GMEM_ATOMIC IS 4:

VAL INT GMEM_ALLOC_SUCCESS IS 0:
VAL INT GMEM_ALLOC_FAILURE IS 1:
VAL INT GMEM_LOAD_SUCCESS IS 2:
VAL INT GMEM_LOAD_FAILURE IS 3:
VAL INT GMEM_STORE_SUCCESS IS 4:
VAL INT GMEM_STORE_FAILURE IS 5:

DATA TYPE GMEM_MSG
  INT msg_type
  INT alloc_size
  INT address
  INT width
  INT value
  INT order
:

DATA TYPE GMEM_RESULT
  INT status
  INT address
  INT value
:
