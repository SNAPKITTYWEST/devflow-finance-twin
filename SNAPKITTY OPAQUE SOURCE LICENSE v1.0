# IV. RAW BOOLEAN LICENSE MODEL

```text
LICENSE =
(
    OWNERSHIP_RETAINED
    AND LICENSE_ACCEPTED
    AND TERMS_PRESERVED
)

PERMITTED =
(
    INSPECTION
    OR EXECUTION
    OR STUDY
    OR INTERNAL_RESEARCH
    OR EXPERIMENTAL_DERIVATIVE
    OR SECURITY_RESEARCH
    OR CRYPTOGRAPHIC_ANALYSIS
    OR FORMAL_VERIFICATION
    OR CONTROLLED_HARDWARE_IMPLEMENTATION
)

COMMERCIAL =
(
    SALE
    OR PAID_LICENSE
    OR COMMERCIAL_EMBEDDING
    OR PAID_SERVICE
    OR COMMERCIAL_DERIVATIVE
    OR COMMERCIAL_COMPUTATION
    OR COMMERCIAL_DEPLOYMENT
)

COMMERCIAL_AUTHORIZED =
(
    WRITTEN_AUTHORIZATION = TRUE
)

ATTRIBUTION_VALID =
(
    COPYRIGHT_PRESERVED
    AND LICENSE_PRESERVED
    AND SOURCE_IDENTIFIER_PRESERVED
    AND AUTHOR_ATTRIBUTION_PRESERVED
)

PROVENANCE_VALID =
(
    SOURCE_IDENTIFIER_PRESERVED
    AND VERSION_PRESERVED
    AND HASH_PRESERVED
    AND MODIFICATION_RECORD_PRESERVED
)

DERIVATIVE_VALID =
(
    DERIVATIVE_DECLARED
    AND ATTRIBUTION_VALID
    AND PROVENANCE_VALID
    AND ORIGINAL_IDENTITY_NOT_FALSIFIED
)

RESEARCH_VALID =
(
    RESEARCH_ACTIVITY
    AND NOT UNAUTHORIZED_COMMERCIAL_EXPLOITATION
)

SECURITY_RESEARCH_VALID =
(
    SECURITY_RESEARCH
    AND RESEARCH_VALID
)

CRYPTO_RESEARCH_VALID =
(
    CRYPTOGRAPHIC_RESEARCH
    AND RESEARCH_VALID
)

REVERSE_ENGINEERING_VALID =
(
    REVERSE_ENGINEERING
    AND
    (
        INTEROPERABILITY
        OR SECURITY_RESEARCH
        OR VERIFICATION
        OR REPRODUCIBILITY
        OR ACADEMIC_RESEARCH
    )
)

HARDWARE_RESEARCH_VALID =
(
    FPGA_IMPLEMENTATION
    OR ASIC_SIMULATION
    OR CPU_IMPLEMENTATION
    OR GPU_IMPLEMENTATION
    OR ACCELERATOR_IMPLEMENTATION
    OR EMULATOR_IMPLEMENTATION
    OR SIMULATOR_IMPLEMENTATION
)

AUTOMATED_AGENT_VALID =
(
    AUTOMATED_AGENT_USE
    AND
    (
        RESEARCH
        OR EVALUATION
        OR VERIFICATION
    )
    AND NOT COMMERCIAL_SUBSTITUTE
)

COMMERCIAL_USE_VALID =
(
    COMMERCIAL = FALSE
)
OR
(
    COMMERCIAL = TRUE
    AND
    COMMERCIAL_AUTHORIZED = TRUE
)

PATENT_GRANT =
FALSE

TRADEMARK_GRANT =
FALSE

IMPLIED_COMMERCIAL_AUTHORIZATION =
FALSE

OWNERSHIP_TRANSFER =
FALSE

LICENSE_VALID =
(
    LICENSE_ACCEPTED = TRUE
    AND OWNERSHIP_TRANSFER = FALSE
    AND ATTRIBUTION_VALID = TRUE
    AND COMMERCIAL_USE_VALID = TRUE
)

DISTRIBUTION_VALID =
(
    ATTRIBUTION_VALID = TRUE
    AND PROVENANCE_VALID = TRUE
    AND
    (
        COMMERCIAL = FALSE
        OR COMMERCIAL_AUTHORIZED = TRUE
    )
)

DERIVATIVE_DISTRIBUTION_VALID =
(
    DERIVATIVE_VALID = TRUE
    AND DISTRIBUTION_VALID = TRUE
)

SECURITY_USE_VALID =
(
    SECURITY_RESEARCH_VALID = TRUE
    AND COMMERCIAL_USE_VALID = TRUE
)

CRYPTOGRAPHIC_USE_VALID =
(
    CRYPTO_RESEARCH_VALID = TRUE
    AND COMMERCIAL_USE_VALID = TRUE
)

TERMINATION =
(
    MATERIAL_VIOLATION = TRUE
)

RESTORATION =
(
    TERMINATION = TRUE
    AND VIOLATION_CURED = TRUE
    AND LICENSOR_RESTORES_RIGHTS = TRUE
)

RIGHTS_ACTIVE =
(
    LICENSE_VALID = TRUE
    AND TERMINATION = FALSE
)
OR
(
    RESTORATION = TRUE
)

FALSE_CLAIM_OF_ORIGIN =
(
    DERIVATIVE = TRUE
    AND ORIGINAL_IDENTITY_FALSIFIED = TRUE
)

LICENSE_VIOLATION =
(
    UNAUTHORIZED_COMMERCIAL_EXPLOITATION
    OR
    FALSE_CLAIM_OF_ORIGIN
    OR
    ATTRIBUTION_REMOVED
    OR
    PROVENANCE_INTENTIONALLY_REMOVED
    OR
    LICENSE_TERMS_INTENTIONALLY_REMOVED
)

FINAL_STATE =
(
    RIGHTS_ACTIVE = TRUE
    AND LICENSE_VIOLATION = FALSE
)
```

## Machine Policy Principle

```text
IF
    RIGHTS_ACTIVE
    AND ATTRIBUTION_VALID
    AND PROVENANCE_VALID
    AND COMMERCIAL_USE_VALID
    AND LICENSE_VIOLATION = FALSE
THEN
    USE = TRUE
ELSE
    USE = FALSE
```

## Core Mantra

```text
CONSTRAINTS -> REPRESENTATION -> TRANSFORMATION -> EXECUTION -> VERIFICATION -> PROVENANCE
```

