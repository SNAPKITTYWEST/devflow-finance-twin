# ============================================================
# DevFlow Telegram Bot — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.

# ----------------------------------------------------------
# Required: Telegram Bot Token
# Get one from @BotFather on Telegram.
# ----------------------------------------------------------
BOT_TOKEN=your_telegram_bot_token_here

# ----------------------------------------------------------
# Ollama LLM Backend
# Runs locally; install from https://ollama.ai/
# Start with: ollama serve
# ----------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2

# Other good choices for OLLAMA_MODEL:
#   mistral      — fast, good for chat
#   codellama    — code-focused tasks
#   llama2:13b   — more capable, needs more RAM
#   mixtral      — mixture of experts, high quality

# ----------------------------------------------------------
# State Persistence (optional)
# Leave blank to use in-memory storage (state lost on restart).
# Provide a path to use SQLite for persistent state.
# ----------------------------------------------------------
DB_PATH=./data/bot-state.db

# ----------------------------------------------------------
# Logging
# Levels: debug | info | warn | error
# ----------------------------------------------------------
LOG_LEVEL=info

# ----------------------------------------------------------
# Rate Limiting
# How many messages a single user can send per interval.
# ----------------------------------------------------------
RATE_LIMIT_TOKENS=5
RATE_LIMIT_INTERVAL_MS=10000
