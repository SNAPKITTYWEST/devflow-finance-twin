  "description": "Node.js/TypeScript reference implementation of the Telegram Bot SDK with agent capabilities, scrum board integration, and Ollama LLM fallback",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test src/**/*.test.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
