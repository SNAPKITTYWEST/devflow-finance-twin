      "invariant_i1_graph_topology_preservation": {
        "claim": "All N neurons remain constant throughout execution (N=760M for whole-brain)",
        "verification_method": "enumerate CAT-N-IDs at t=0 and t=T; verify perfect match",
        "required_evidence": [
          "neuron_count_t0",
          "neuron_ids_hash_t0",
          "neuron_count_tT",
          "neuron_ids_hash_tT",
          "mismatch_count"
        ],
        "pass_criteria": {
          "neuron_count_match": "neuron_count_t0 == neuron_count_tT",
          "hash_match": "neuron_ids_hash_t0 == neuron_ids_hash_tT",
          "mismatch_tolerance": "== 0"
        },
        "timestamp_checkpoints": ["t=0", "t=T/4", "t=T/2", "t=3T/4", "t=T"],
        "status": "PENDING",
        "evidence": {}
      },
      "invariant_i17_recurrent_connectivity_preserved": {
        "claim": "All feedback loops remain executable; cycles broken temporally via delays >= 1ms",
        "verification_method": "enumerate CAT-S edges; verify no edge deleted; verify all delays >= 1ms",
        "required_evidence": [
          "baseline_edges_t0",
          "baseline_cycle_count",
          "baseline_recurrent_edges",
          "min_delay_ms",
          "final_edges_tT",
          "final_cycle_count",
          "deleted_edges",
          "new_edges"
        ],
        "pass_criteria": {
          "no_edge_deletion": "len(deleted_edges) == 0",
          "no_edge_creation": "len(new_edges) == 0",
          "cycle_preservation": "final_cycle_count == baseline_cycle_count",
          "delay_preservation": "min_delay_ms >= 1.0"
        },
        "status": "PENDING",
        "evidence": {}
      },
      "invariant_i18_temporal_state_preservation": {
        "claim": "state[t] deterministically derived from state[0..t] + inputs",
        "verification_method": "run with fixed seed twice; compare bit-for-bit spike sequences",
        "required_evidence": [
          "seed",
          "initial_state_hash",
          "spike_trace_run1_hash",
          "spike_trace_run2_hash",
          "hash_match_status",
          "divergence_point",
          "spot_check_neurons_match"
        ],
        "pass_criteria": {
          "canonical_hash_match": "spike_trace_run1_hash == spike_trace_run2_hash",
          "no_divergence": "divergence_point == NULL",
          "spot_checks": "100 random neurons all match"
        },
        "status": "PENDING",
        "evidence": {}
      },
      "invariant_i19_neurotransmitter_receptor_traceability": {
        "claim": "Every spike carries neurotransmitter ID; every synapse carries receptor type",
        "verification_method": "random sample 1000 synapses; verify all have valid NT/receptor pairs",
        "required_evidence": [
          "sample_size",
          "valid_pairs",
          "mismatch_count",
          "neurotransmitter_distribution",
          "spike_events_count",
          "spike_nt_mismatch_count"
        ],
        "pass_criteria": {
          "sample_validity": "valid_pairs == sample_size",
          "mismatch_tolerance": "mismatch_count == 0",
          "spike_nt_accuracy": "spike_nt_mismatch_count == 0"
