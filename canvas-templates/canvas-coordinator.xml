  <architecture>
    <layer name="Backend Coordinator API">
      <layer name="Session + step machine">
        <layer name="Command / Event contract"/>
      </layer>
      <layer name="AppCoordinator (Swift)">
        <layer name="Auth / Sync / Work children"/>
        <layer name="AssemblyBridge.crc32"/>
      </layer>
    </layer>
  </architecture>

  <component name="Backend coordinator">
    <property key="role">Source of truth for the next legal command</property>
    <property key="steps">boot, authenticate, hydrate, work, complete</property>
    <property key="endpoints">POST /sessions, GET /sessions/{id}, POST /sessions/{id}/advance</property>
    <property key="invariant">Client never invents the next step</property>
  </component>

  <component name="On-device coordinators">
    <property key="protocol">Coordinator: children, start(), stop()</property>
    <property key="root">AppCoordinator opens a session and dispatches ServerCommand</property>
    <property key="children">AuthCoordinator, SyncCoordinator, WorkCoordinator</property>
    <property key="threading">@MainActor for UI; BackendClient is an actor</property>
  </component>

  <component name="Assembly hot path">
    <property key="symbol">crc32_asm</property>
    <property key="abi">AAPCS64: x0 = buf, x1 = len, w0 = crc</property>
    <property key="poly">IEEE 0xEDB88320, init/final XOR 0xFFFFFFFF</property>
    <property key="why">Allocation-free checksum before task_done</property>
  </component>

