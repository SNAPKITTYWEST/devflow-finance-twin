/* examples/arithmetic.b */
main() {
    x = 17; y = 5;
    out(x + y); /* 22 */
    out(x - y); /* 12 */
    out(x * y); /* 85 */
    out(x / y); /* 3 */
    out(x % y); /* 2 */
    out(x & y); /* 1 */
    out(x | y); /* 21 */
    out(x ^ y); /* 20 */
    out(x << 1); /* 34 */
    out(x >> 1); /* 8 */
}
