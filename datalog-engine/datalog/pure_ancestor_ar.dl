// pure_ancestor.dl
// محرك Datalog باستخدام Soufflé
// مثال على الحقائق والقواعد والاستعلامات

// ------------------------------------------------------------
// تعريف علاقة parent
// ------------------------------------------------------------

.decl parent(x:symbol, y:symbol)
.input parent

// ------------------------------------------------------------
// تعريف علاقة ancestor
// ------------------------------------------------------------

.decl ancestor(x:symbol, y:symbol)
.output ancestor

// ------------------------------------------------------------
// القاعدة الأولى:
// كل والد هو سلف مباشر
// ------------------------------------------------------------

ancestor(X, Y) :-
    parent(X, Y).

// ------------------------------------------------------------
// القاعدة الثانية:
// إذا كان X والدًا لـ Z، وكان Z سلفًا لـ Y،
// فإن X سلف لـ Y.
// ------------------------------------------------------------

ancestor(X, Y) :-
    parent(X, Z),
    ancestor(Z, Y).

// ------------------------------------------------------------
// حقائق المثال
// ------------------------------------------------------------

parent("alice", "bob").
parent("bob", "carol").
parent("alice", "dave").
parent("eve", "alice").

// ------------------------------------------------------------
// استعلامات
// ------------------------------------------------------------

.decl query_alice(y:symbol)
.output query_alice

query_alice(Y) :-
    ancestor("alice", Y).

.decl query_carol(x:symbol)
.output query_carol

query_carol(X) :-
    ancestor(X, "carol").
